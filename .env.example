# ==========================================
# RIDE TOKENS Protocol - Environment Configuration
# Target Network: Sidra Chain Mainnet
# ==========================================

# Blockchain Network Configuration
RPC_URL=https://rpc.sidrachain.com
CHAIN_ID=97453
EXPLORER_URL=https://ledger.sidrachain.com

# Core Deployed Token Contracts (Authoritative - DO NOT REPLACE)
RIDE_ADDRESS=0xe91cAC00C1092611EB598B284a87A623a35aF9b7
WSDA_ADDRESS=0xE4095a910209D7BE03B55D02F40d4554B1666182
ROUTER_ADDRESS=0x35cAC72Db00e8dAC0e4f7F8A0F53D339E0cC23fb
RIDE_POOL_ADDRESS=0x4a65a79dbC3e0184972e041525eDeeAb481c6027
RIDE_POOL_FEE=10000

# Deployed RIDE Protocol Escrow & Staking (from config/protocol_contracts.json)
ESCROW_CONTRACT_ADDRESS=0x67C92233f269a83B38787042a3FaAee1E606e12e
STAKING_VAULT_ADDRESS=0xb1858A83d3e6c0c26D6a58A3E40e34b92b67e8Fe
REWARDS_DISTRIBUTOR_ADDRESS=0x83B3698A4479e083c5095e7F0a2FE91148674d8D

# Real-Time Dispatch Backend Server
PORT=3001
DISPATCH_SECRET=replace_with_secure_jwt_or_session_secret
DATABASE_PATH=./data/ride_dispatch.sqlite
OSRM_BACKEND_URL=https://router.project-osrm.org

# Deployer / Verifier Credentials (NEVER COMMIT REAL PRIVATE KEYS)
# Format: 64-character hex string without 0x prefix
PRIVATE_KEY=your_deployer_private_key_here
VERIFIER_PRIVATE_KEY=your_verifier_signing_key_here

# Trading / Simulation Controls
LIVE=false
TRADE_SIZE_SDA=0.02
BUY_COUNT=3
MIN_SDA_RESERVE=0.5
MAX_SLIPPAGE_BPS=100
WALLET_DELAY_MS=3000
GAS_PRICE_WEI=2500000000
